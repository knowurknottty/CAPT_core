{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/mission.schema.json",
  "title": "CAPT mission contracts",
  "x-domain": "mission",
  "$defs": {
    "MissionState": {
      "title": "MissionState",
      "type": "string",
      "enum": ["draft", "authorized", "executing", "suspended", "completed", "failed", "cancelled"]
    },
    "Constraint": {
      "title": "Constraint",
      "description": "Discriminated union. Ledger Finding C: no arbitrary payload is permitted in a constraint.",
      "x-discriminator": "kind",
      "oneOf": [
        {
          "title": "ForbiddenOperationConstraint",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "constraintId", "origin", "operations"],
          "properties": {
            "kind": { "type": "string", "const": "forbidden_operation" },
            "constraintId": { "$ref": "common.schema.json#/$defs/Identifier" },
            "origin": { "$ref": "mission.schema.json#/$defs/ConstraintOrigin" },
            "operations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" } }
          }
        },
        {
          "title": "ResourceBoundaryConstraint",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "constraintId", "origin", "scope"],
          "properties": {
            "kind": { "type": "string", "const": "resource_boundary" },
            "constraintId": { "$ref": "common.schema.json#/$defs/Identifier" },
            "origin": { "$ref": "mission.schema.json#/$defs/ConstraintOrigin" },
            "scope": { "$ref": "capability.schema.json#/$defs/ResourceScope" }
          }
        },
        {
          "title": "BudgetConstraint",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "constraintId", "origin", "budget"],
          "properties": {
            "kind": { "type": "string", "const": "budget" },
            "constraintId": { "$ref": "common.schema.json#/$defs/Identifier" },
            "origin": { "$ref": "mission.schema.json#/$defs/ConstraintOrigin" },
            "budget": { "$ref": "common.schema.json#/$defs/Budget" }
          }
        },
        {
          "title": "ApprovalRequiredConstraint",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "constraintId", "origin", "approverRole"],
          "properties": {
            "kind": { "type": "string", "const": "approval_required" },
            "constraintId": { "$ref": "common.schema.json#/$defs/Identifier" },
            "origin": { "$ref": "mission.schema.json#/$defs/ConstraintOrigin" },
            "approverRole": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,63}$" }
          }
        }
      ]
    },
    "ConstraintOrigin": {
      "title": "ConstraintOrigin",
      "description": "Provenance of a constraint. 'inferred' constraints carry lower authority and are surfaced separately (spec 7.2).",
      "type": "string",
      "enum": ["explicit_user", "inferred", "policy_added"]
    },
    "Objective": {
      "title": "Objective",
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveId", "statement", "priority"],
      "properties": {
        "objectiveId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "SuccessCriterion": {
      "title": "SuccessCriterion",
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "statement", "requiresVerification"],
      "properties": {
        "criterionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "requiresVerification": { "type": "boolean" }
      }
    },
    "TerminationCriterion": {
      "title": "TerminationCriterion",
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "statement", "terminalState"],
      "properties": {
        "criterionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "terminalState": { "type": "string", "enum": ["completed", "failed", "cancelled"] }
      }
    },
    "MissionSpec": {
      "title": "MissionSpec",
      "description": "Compiled mission. Preserves raw and normalized input plus constraint provenance (spec 7.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "missionId", "rawRequest", "normalizedRequest", "objectives", "constraints", "successCriteria", "terminationCriteria", "unresolvedAmbiguities", "createdAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "missionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "rawRequest": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "normalizedRequest": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "objectives": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "mission.schema.json#/$defs/Objective" } },
        "constraints": { "type": "array", "maxItems": 128, "items": { "$ref": "mission.schema.json#/$defs/Constraint" } },
        "successCriteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "mission.schema.json#/$defs/SuccessCriterion" } },
        "terminationCriteria": { "type": "array", "maxItems": 64, "items": { "$ref": "mission.schema.json#/$defs/TerminationCriterion" } },
        "unresolvedAmbiguities": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1024 } },
        "taskGraphId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    }
  }
}
