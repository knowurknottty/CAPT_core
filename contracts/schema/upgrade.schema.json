{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/upgrade.schema.json",
  "title": "CAPT governed upgrade aggregate contracts",
  "x-domain": "upgrade",
  "$defs": {
    "UpgradeAbsolutePath": {
      "title": "UpgradeAbsolutePath",
      "description": "Absolute normalized path bound into a governed upgrade transaction.",
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "maxLength": 4096
    },
    "ArtifactAdoptionReceipt": {
      "title": "ArtifactAdoptionReceipt",
      "description": "Mechanical receipt from an already-authorized artifact adoption step; not authorization itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinationPath",
        "contentDigest",
        "operation",
        "atomicReplace"
      ],
      "properties": {
        "destinationPath": {
          "$ref": "upgrade.schema.json#/$defs/UpgradeAbsolutePath"
        },
        "contentDigest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "operation": {
          "type": "string",
          "enum": [
            "atomic_replace",
            "already_present_reconciled"
          ]
        },
        "atomicReplace": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "ArtifactPromotionState": {
      "title": "ArtifactPromotionState",
      "description": "Authoritative source/destination/digest-bound promotion transaction. ClaimGuard does not own this state machine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionId",
        "candidateId",
        "workspaceId",
        "sourcePath",
        "destinationPath",
        "contentDigest",
        "claimId",
        "verificationId",
        "evidenceId",
        "preparedAt",
        "authorizedAt",
        "authorizedBy",
        "adoptedAt",
        "discardedAt",
        "discardReason",
        "adoptionReceipt",
        "state"
      ],
      "properties": {
        "promotionId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "candidateId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "workspaceId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "sourcePath": {
          "$ref": "upgrade.schema.json#/$defs/UpgradeAbsolutePath"
        },
        "destinationPath": {
          "$ref": "upgrade.schema.json#/$defs/UpgradeAbsolutePath"
        },
        "contentDigest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "claimId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "verificationId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "evidenceId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "preparedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "authorizedAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizedBy": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "adoptedAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "discardedAt": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "discardReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "adoptionReceipt": {
          "oneOf": [
            {
              "$ref": "upgrade.schema.json#/$defs/ArtifactAdoptionReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "prepared",
            "authorized",
            "adopted",
            "discarded"
          ]
        }
      }
    },
    "CohortContributionOutcome": {
      "title": "CohortContributionOutcome",
      "type": "string",
      "enum": [
        "CONTRIBUTE",
        "PASS",
        "DISSENT",
        "ESCALATE",
        "REQUEST_EVIDENCE",
        "FAILED",
        "UNAVAILABLE",
        "TIMED_OUT",
        "INDETERMINATE"
      ]
    },
    "CohortEscalationCategory": {
      "title": "CohortEscalationCategory",
      "type": "string",
      "enum": [
        "AUTHORITY_REQUIRED",
        "VALUE_JUDGMENT",
        "AMBIGUOUS_INTENT",
        "MISSING_EVIDENCE",
        "IRREVERSIBLE_ACTION",
        "COST_APPROVAL",
        "CONFLICT_RESOLUTION",
        "SAFETY_BOUNDARY"
      ]
    },
    "CohortStoppingReason": {
      "title": "CohortStoppingReason",
      "type": "string",
      "enum": [
        "SILENCE_QUORUM",
        "BOUNDED_INCOMPLETE"
      ]
    },
    "CohortContribution": {
      "title": "CohortContribution",
      "description": "Durable structured contribution identity/outcome; raw model token streams are not authoritative Cohort state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributionId",
        "participant",
        "epoch",
        "round",
        "outcome",
        "cursor",
        "sourceSequences",
        "material",
        "escalation"
      ],
      "properties": {
        "contributionId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "participant": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "$ref": "upgrade.schema.json#/$defs/CohortContributionOutcome"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSequences": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "material": {
          "type": "boolean"
        },
        "escalation": {
          "oneOf": [
            {
              "$ref": "upgrade.schema.json#/$defs/CohortEscalationCategory"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CohortSteer": {
      "title": "CohortSteer",
      "description": "Durable human steering directive. It changes deliberation epoch but grants no capability.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directive",
        "reason",
        "steeredBy",
        "steeredAt",
        "epoch"
      ],
      "properties": {
        "directive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "steeredBy": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "steeredAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "CohortSnapshot": {
      "title": "CohortSnapshot",
      "description": "Authoritative bounded Cohort reconstruction state. Aggregate invariants additionally enforce cursor monotonicity, immutable bindings, and contribution retention.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortId",
        "missionId",
        "taskId",
        "epoch",
        "rounds",
        "roundCap",
        "participantCap",
        "required",
        "roster",
        "participantCursors",
        "contributions",
        "stoppingReason",
        "evidenceIds",
        "latestSteer"
      ],
      "properties": {
        "cohortId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "missionId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/Identifier"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "roundCap": {
          "type": "integer",
          "minimum": 1
        },
        "participantCap": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "common.schema.json#/$defs/Identifier"
          }
        },
        "roster": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "common.schema.json#/$defs/Identifier"
          }
        },
        "participantCursors": {
          "description": "Participant -> last admitted global-sequence cursor. CohortAggregate validates keys and monotonic values.",
          "type": "object"
        },
        "contributions": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "upgrade.schema.json#/$defs/CohortContribution"
          }
        },
        "stoppingReason": {
          "oneOf": [
            {
              "$ref": "upgrade.schema.json#/$defs/CohortStoppingReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "common.schema.json#/$defs/Identifier"
          }
        },
        "latestSteer": {
          "oneOf": [
            {
              "$ref": "upgrade.schema.json#/$defs/CohortSteer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
