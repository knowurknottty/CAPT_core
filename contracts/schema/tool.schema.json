{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/tool.schema.json",
  "title": "CAPT tool request/result contracts",
  "x-domain": "tool",
  "$defs": {
    "ToolArgument": {
      "title": "ToolArgument",
      "description": "Typed argument. A generic map would allow injection of unvalidated parameters into a consequential call.",
      "x-discriminator": "kind",
      "oneOf": [
        {
          "title": "StringArgument",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "type": "string", "const": "string" },
            "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
            "value": { "type": "string", "maxLength": 65536 }
          }
        },
        {
          "title": "IntegerArgument",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "type": "string", "const": "integer" },
            "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
            "value": { "type": "integer" }
          }
        },
        {
          "title": "BooleanArgument",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "type": "string", "const": "boolean" },
            "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
            "value": { "type": "boolean" }
          }
        },
        {
          "title": "PathArgument",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "type": "string", "const": "path" },
            "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
            "value": { "type": "string", "pattern": "^/[^\\u0000]*$", "maxLength": 4096 }
          }
        }
      ]
    },
    "TerminalBackendId": {
      "title": "TerminalBackendId",
      "type": "string",
      "enum": ["local", "ssh", "docker"]
    },
    "ToolReadinessStatus": {
      "title": "ToolReadinessStatus",
      "type": "string",
      "enum": ["available", "degraded", "unavailable", "unverified"]
    },
    "ToolEffectClass": {
      "title": "ToolEffectClass",
      "type": "string",
      "enum": ["pure_read_only", "ephemeral_external", "durable_local", "durable_remote", "resource_creation"]
    },
    "ToolExecutionState": {
      "title": "ToolExecutionState",
      "type": "string",
      "enum": ["prepared", "admitted", "dispatching", "effect_observed", "settling", "completed", "failed", "cancelled", "indeterminate"]
    },
    "ToolDispatchBoundary": {
      "title": "ToolDispatchBoundary",
      "type": "string",
      "enum": ["not_started", "started", "effect_observed", "response_completed"]
    },
    "ToolSettlementStatus": {
      "title": "ToolSettlementStatus",
      "type": "string",
      "enum": ["not_settled", "settling", "settled", "reconciliation_required"]
    },
    "ToolOperationEffect": {
      "title": "ToolOperationEffect",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "effectClass"],
      "properties": {
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" },
        "effectClass": { "$ref": "tool.schema.json#/$defs/ToolEffectClass" }
      }
    },
    "ToolDescriptor": {
      "title": "ToolDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolId", "displayName", "family", "operations", "requiredCapabilities", "operationEffects", "terminalBackends", "platforms", "supportsTimeout", "supportsCancellation", "idempotencySupport", "artifactOutputs"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "toolId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "family": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" } },
        "requiredCapabilities": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,127}$" } },
        "operationEffects": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "tool.schema.json#/$defs/ToolOperationEffect" } },
        "terminalBackends": { "type": "array", "maxItems": 3, "items": { "$ref": "tool.schema.json#/$defs/TerminalBackendId" } },
        "platforms": { "type": "array", "maxItems": 3, "items": { "type": "string", "enum": ["macos", "linux", "windows"] } },
        "supportsTimeout": { "type": "boolean" },
        "supportsCancellation": { "type": "boolean" },
        "idempotencySupport": { "type": "string", "enum": ["none", "adapter", "broker_settled_replay", "reconcile_before_retry"] },
        "artifactOutputs": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 128 } }
      }
    },
    "ToolReadiness": {
      "title": "ToolReadiness",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolId", "status", "reason", "checkedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "toolId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "status": { "$ref": "tool.schema.json#/$defs/ToolReadinessStatus" },
        "reason": { "type": "string", "maxLength": 2048 },
        "checkedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ToolRequest": {
      "title": "ToolRequest",
      "description": "leaseId is REQUIRED for a consequential request: no side effect without a lease (invariant 7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolRequestId", "toolId", "operation", "arguments", "consequential", "idempotencyKey", "operationFingerprint", "replayPolicy", "requestedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "toolRequestId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "toolId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" },
        "arguments": { "type": "array", "maxItems": 64, "items": { "$ref": "tool.schema.json#/$defs/ToolArgument" } },
        "consequential": { "type": "boolean" },
        "grantId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "leaseId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "reservationId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "backendId": { "oneOf": [{ "$ref": "tool.schema.json#/$defs/TerminalBackendId" }, { "type": "null" }] },
        "targetIdentity": { "type": ["string", "null"], "maxLength": 4096 },
        "filesystemScope": { "type": ["string", "null"], "pattern": "^/[^\\u0000]*$", "maxLength": 4096 },
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operationFingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
        "replayPolicy": { "$ref": "common.schema.json#/$defs/ReplayPolicy" },
        "requestedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ToolExecution": {
      "title": "ToolExecution",
      "description": "Durable broker-owned execution state. Adapter output is evidence, not verification authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolExecutionId", "toolRequestId", "operatorId", "sessionId", "toolId", "operation", "operationFingerprint", "descriptorDigest", "adapterId", "backendId", "effectClass", "consequential", "grantId", "leaseId", "reservationId", "state", "dispatchBoundary", "result", "resultDigest", "sideEffectIdentity", "settlementStatus", "reconciliationReason", "preparedAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "toolExecutionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "toolRequestId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operatorId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "sessionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "toolId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" },
        "operationFingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
        "descriptorDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "adapterId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "backendId": { "oneOf": [{ "$ref": "tool.schema.json#/$defs/TerminalBackendId" }, { "type": "null" }] },
        "effectClass": { "$ref": "tool.schema.json#/$defs/ToolEffectClass" },
        "consequential": { "type": "boolean" },
        "grantId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "leaseId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "reservationId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "state": { "$ref": "tool.schema.json#/$defs/ToolExecutionState" },
        "dispatchBoundary": { "$ref": "tool.schema.json#/$defs/ToolDispatchBoundary" },
        "result": { "oneOf": [{ "$ref": "tool.schema.json#/$defs/ToolResult" }, { "type": "null" }] },
        "resultDigest": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Digest" }, { "type": "null" }] },
        "sideEffectIdentity": { "type": ["string", "null"], "maxLength": 2048 },
        "settlementStatus": { "$ref": "tool.schema.json#/$defs/ToolSettlementStatus" },
        "reconciliationReason": { "type": ["string", "null"], "maxLength": 2048 },
        "preparedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "ToolResultStatus": {
      "title": "ToolResultStatus",
      "type": "string",
      "enum": ["succeeded", "failed", "indeterminate", "denied"]
    },
    "ToolResult": {
      "title": "ToolResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "toolResultId", "toolRequestId", "status", "output", "completedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "toolResultId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "toolRequestId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "status": { "$ref": "tool.schema.json#/$defs/ToolResultStatus" },
        "output": { "type": "array", "maxItems": 128, "items": { "$ref": "tool.schema.json#/$defs/ToolArgument" } },
        "exitCode": { "type": ["integer", "null"] },
        "outputDigest": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Digest" }, { "type": "null" }] },
        "sideEffectIdentity": { "type": ["string", "null"], "maxLength": 1024 },
        "error": { "oneOf": [{ "$ref": "common.schema.json#/$defs/ErrorEnvelope" }, { "type": "null" }] },
        "completedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    }
  }
}
