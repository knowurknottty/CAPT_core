{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/common.schema.json",
  "title": "CAPT common contract primitives",
  "x-domain": "common",
  "$defs": {
    "SchemaVersion": {
      "title": "SchemaVersion",
      "description": "Contract-set version. Readers MUST reject an unequal value (ADR-0101).",
      "type": "string",
      "const": "1.0.0"
    },
    "Identifier": {
      "title": "Identifier",
      "description": "Opaque, caller-minted identifier. Bounded charset prevents injection into paths, SQL, and log lines.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "StreamId": {
      "title": "StreamId",
      "description": "Aggregate stream identifier. The prefix declares the owning aggregate (ADR-0103) and is enforced by the store.",
      "type": "string",
      "pattern": "^(mission|task|capability|driverrun|claim|human_approval)-[A-Za-z0-9_.-]{1,96}$"
    },
    "Timestamp": {
      "title": "Timestamp",
      "description": "RFC 3339 UTC instant. Descriptive only: never used for ordering or conflict resolution (ADR-0106).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Digest": {
      "title": "Digest",
      "description": "Lowercase hex SHA-256 with algorithm prefix.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AggregateVersion": {
      "title": "AggregateVersion",
      "description": "0 means the stream does not yet exist. Increments by exactly 1 per event.",
      "type": "integer",
      "minimum": 0
    },
    "SequenceNumber": {
      "title": "SequenceNumber",
      "type": "integer",
      "minimum": 1
    },
    "ActorKind": {
      "title": "ActorKind",
      "type": "string",
      "enum": ["human", "governance_kernel", "cognitive_plane", "execution_plane", "verification_plane", "claim_authority", "external_driver", "system"]
    },
    "ActorRef": {
      "title": "ActorRef",
      "description": "Who performed an action. 'kind' carries the authority domain and is checked by authority invariants.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "kind"],
      "properties": {
        "actorId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "kind": { "$ref": "common.schema.json#/$defs/ActorKind" },
        "displayName": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "ReplayPolicy": {
      "title": "ReplayPolicy",
      "description": "never: no automatic re-execution. safe: externally idempotent. verify-before-retry: observe external state first (ADR-0108).",
      "type": "string",
      "enum": ["never", "safe", "verify-before-retry"]
    },
    "CommandMetadata": {
      "title": "CommandMetadata",
      "description": "Mandatory envelope for every consequential command (ADR-0108).",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "commandId", "idempotencyKey", "operationFingerprint", "correlationId", "actor", "issuedAt", "replayPolicy", "attempt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "commandId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operationFingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
        "correlationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "causationId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "actor": { "$ref": "common.schema.json#/$defs/ActorRef" },
        "issuedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "replayPolicy": { "$ref": "common.schema.json#/$defs/ReplayPolicy" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "ExtensionEnvelope": {
      "title": "ExtensionEnvelope",
      "description": "THE ONLY permitted generic payload boundary (ADR-0102). Namespaced, validated, and never present in a security-critical decision field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "payloadDigest", "payloadJson"],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^x-[a-z0-9]+(\\.[a-z0-9]+)*$",
          "maxLength": 128
        },
        "payloadDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "payloadJson": {
          "description": "Serialized JSON string, not a live object. Keeps untyped data out of the typed tree and forces explicit parsing.",
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "ErrorCategory": {
      "title": "ErrorCategory",
      "type": "string",
      "enum": ["validation", "authority", "concurrency", "idempotency", "integrity", "not_found", "illegal_transition", "capability_denied", "reconciliation_required", "internal"]
    },
    "ErrorEnvelope": {
      "title": "ErrorEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "category", "code", "message", "occurredAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "category": { "$ref": "common.schema.json#/$defs/ErrorCategory" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "maxLength": 2048 },
        "occurredAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "correlationId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "streamId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/StreamId" }, { "type": "null" }] },
        "expectedVersion": { "type": ["integer", "null"], "minimum": 0 },
        "actualVersion": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "Budget": {
      "title": "Budget",
      "type": "object",
      "additionalProperties": false,
      "required": ["wallClockSeconds", "maxOperations"],
      "properties": {
        "wallClockSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maxOperations": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "RiskClassification": {
      "title": "RiskClassification",
      "description": "Operator-facing risk band for a bounded approval request. Advisory only; CAPT authority invariants remain the sole enforcement path.",
      "type": "string",
      "enum": ["none", "low", "medium", "high", "consequential"]
    },
    "OperatorMissionIntent": {
      "title": "OperatorMissionIntent",
      "description": "High-level operator intent submitted to CAPT Runtime to create a bounded mission. The runtime owns all planning: it constructs the MissionSpec, TaskNode, and (when requiresApproval) HumanApprovalRequest from this intent. The desktop never builds aggregates. Additive M1 extension under contract 1.0.0 (ADR-DT-M1-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "missionId", "objective", "scope", "requiresApproval"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "missionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "objective": { "type": "string", "maxLength": 4096 },
        "rawRequest": { "type": ["string", "null"], "maxLength": 8192 },
        "normalizedRequest": { "type": ["string", "null"], "maxLength": 8192 },
        "scope": { "type": "object", "additionalProperties": true },
        "constraints": { "type": "array", "items": { "type": "object" } },
        "successCriteria": { "type": "array", "items": { "type": "object" } },
        "terminationCriteria": { "type": "array", "items": { "type": "object" } },
        "unresolvedAmbiguities": { "type": "array", "items": { "type": "string" } },
        "budget": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "maxEvents": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "requiresApproval": { "type": "boolean" },
        "requestedCapability": { "type": "string", "maxLength": 256 },
        "resource": { "type": ["string", "null"], "maxLength": 1024 },
        "operation": { "type": ["string", "null"], "maxLength": 128 },
        "riskClassification": { "$ref": "common.schema.json#/$defs/RiskClassification" },
        "policyReason": { "type": ["string", "null"], "maxLength": 1024 },
        "taskId": { "type": ["string", "null"], "maxLength": 256 },
        "requestId": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "MemoryTriggerPolicy": {
      "title": "MemoryTriggerPolicy",
      "description": "CAPT-owned mandatory memory trigger policy. The trigger interval is a fixed 32,768 tokens; each trigger type has an independent step count. Drivers and the desktop may not widen a higher-authority bound. Additive M1-memory extension under contract 1.0.0 (ADR-DT-M1-MEM-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "policyVersion", "triggerIntervalTokens",
        "retrievalTriggerSteps", "compressionTriggerSteps",
        "checkpointTriggerSteps", "consolidationTriggerSteps",
        "hardStopTriggerSteps", "modelSafeLimitSteps", "source"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "triggerIntervalTokens": { "const": 32768 },
        "retrievalTriggerSteps": { "type": "integer", "minimum": 1 },
        "compressionTriggerSteps": { "type": "integer", "minimum": 1 },
        "checkpointTriggerSteps": { "type": "integer", "minimum": 1 },
        "consolidationTriggerSteps": { "type": "integer", "minimum": 1 },
        "hardStopTriggerSteps": { "type": "integer", "minimum": 1 },
        "modelSafeLimitSteps": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "enum": ["constitutional", "runtime_policy", "model_provider", "project_policy", "operator_selected", "driver_preference"] },
        "operatorId": { "type": ["string", "null"], "maxLength": 256 },
        "previousPolicyDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "policyDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "MemoryQuery": {
      "title": "MemoryQuery",
      "description": "Typed mandatory memory query emitted by CAPT when a retrieval trigger fires. No anonymous text blobs. Additive M1-memory extension under contract 1.0.0 (ADR-DT-M1-MEM-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "missionId", "taskId", "actor", "requestingSubsystem",
        "triggerBoundary", "contextUsage", "requestedMemoryClasses", "purpose",
        "recordLimit", "tokenBudget", "correlationId"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "missionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "taskId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "driverRunId": { "type": ["string", "null"], "maxLength": 256 },
        "actor": { "type": "string", "maxLength": 256 },
        "requestingSubsystem": { "type": "string", "maxLength": 128 },
        "triggerBoundary": { "type": "integer", "minimum": 0 },
        "contextUsage": { "type": "integer", "minimum": 0 },
        "requestedMemoryClasses": { "type": "array", "items": { "type": "string" } },
        "projectScope": { "type": ["string", "null"], "maxLength": 256 },
        "purpose": { "type": "string", "maxLength": 2048 },
        "relevanceCriteria": { "type": ["string", "null"], "maxLength": 2048 },
        "timeRange": { "type": ["object", "null"], "additionalProperties": true },
        "trustThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "consentScope": { "type": ["string", "null"], "maxLength": 256 },
        "sensitivityAllowance": { "type": ["string", "null"], "maxLength": 64 },
        "recordLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "tokenBudget": { "type": "integer", "minimum": 0 },
        "provenanceRequirement": { "type": ["string", "null"], "maxLength": 256 },
        "correlationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "causationId": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "MemoryRecord": {
      "title": "MemoryRecord",
      "description": "A returned memory record with full provenance and governance metadata. No anonymous text blobs. Additive M1-memory extension under contract 1.0.0 (ADR-DT-M1-MEM-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId", "memoryClass", "owner", "source", "provenance", "trust",
        "verificationStatus", "sensitivity", "consent", "digest"
      ],
      "properties": {
        "recordId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "memoryClass": { "type": "string", "maxLength": 64 },
        "owner": { "type": "string", "maxLength": 256 },
        "source": { "type": "string", "maxLength": 512 },
        "provenance": { "type": "string", "maxLength": 1024 },
        "trust": { "type": "string", "maxLength": 32 },
        "verificationStatus": { "type": "string", "maxLength": 32 },
        "sensitivity": { "type": "string", "maxLength": 32 },
        "consent": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": ["string", "null"], "maxLength": 64 },
        "lastVerifiedAt": { "type": ["string", "null"], "maxLength": 64 },
        "expiresAt": { "type": ["string", "null"], "maxLength": 64 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "retrievalScore": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "retrievalReason": { "type": "string", "maxLength": 512 },
        "stale": { "type": "boolean" },
        "conflictState": { "type": ["string", "null"], "maxLength": 64 },
        "downstreamUseRestriction": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "ContextPack": {
      "title": "ContextPack",
      "description": "Governed, idempotent context packet assembled by CAPT from a mandatory memory query. Drivers receive only the authorized slice. Additive M1-memory extension under contract 1.0.0 (ADR-DT-M1-MEM-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "contextPackId", "policyVersion", "triggerBoundary",
        "contextUsageBefore", "contextUsageAfter", "selectedRecords",
        "excludedRecords", "tokenBudget", "contextPackDigest"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "contextPackId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "triggerBoundary": { "type": "integer", "minimum": 0 },
        "contextUsageBefore": { "type": "integer", "minimum": 0 },
        "contextUsageAfter": { "type": "integer", "minimum": 0 },
        "selectedRecords": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/MemoryRecord" } },
        "excludedRecords": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "exclusionReasons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "compressionActions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "summariesGenerated": { "type": "array", "items": { "type": "string" } },
        "provenanceRetained": { "type": "boolean" },
        "unresolvedConflicts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "staleRecords": { "type": "array", "items": { "type": "string" } },
        "redactions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "tokenBudget": { "type": "integer", "minimum": 0 },
        "previousContextPackDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "contextPackDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "missionId": { "type": ["string", "null"], "maxLength": 256 },
        "taskId": { "type": ["string", "null"], "maxLength": 256 },
        "driverRunId": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "HumanApprovalRequest": {
      "title": "HumanApprovalRequest",
      "description": "A bounded request for operator authorization before a consequential action. Authored by the governance kernel / execution plane; decided by a human operator. Additive M1 extension under contract 1.0.0 (ADR-DT-M1-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "missionId", "taskId", "requestedCapability",
        "resource", "operation", "scope", "riskClassification", "policyReason",
        "requestedBy", "expiresAt", "correlationId", "createdAt"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "requestId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "missionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "taskId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "requestedCapability": { "type": "string", "maxLength": 256 },
        "resource": { "type": "string", "maxLength": 1024 },
        "operation": { "type": "string", "maxLength": 128 },
        "scope": { "type": "object", "additionalProperties": true },
        "riskClassification": { "$ref": "common.schema.json#/$defs/RiskClassification" },
        "policyReason": { "type": "string", "maxLength": 1024 },
        "requestedBy": { "$ref": "common.schema.json#/$defs/ActorRef" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "remainingUses": { "type": ["integer", "null"], "minimum": 1 },
        "correlationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "HumanApprovalDecision": {
      "title": "HumanApprovalDecision",
      "description": "Operator decision on a HumanApprovalRequest. 'approve' permits only the originally requested scope; 'deny' must prevent execution. Idempotent by idempotencyKey. Additive M1 extension under contract 1.0.0 (ADR-DT-M1-001).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "requestId", "decision", "operatorId", "decidedAt",
        "idempotencyKey", "correlationId"
      ],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "requestId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "decision": { "type": "string", "enum": ["approve", "deny"] },
        "operatorId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "decidedAt": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "note": { "type": ["string", "null"], "maxLength": 1024 },
        "idempotencyKey": { "$ref": "common.schema.json#/$defs/Identifier" },
        "correlationId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "sessionId": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  }
}
