            "eventType": {
              "type": "string",
              "const": "CheckpointCreated"
            },
            "checkpointId": {
              "$ref": "common.schema.json#/$defs/Identifier"
            },
            "integrityDigest": {
              "$ref": "common.schema.json#/$defs/Digest"
            }
          }
        },
        {
          "title": "MissionResumedPayload",
