{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/policy.schema.json",
  "title": "CAPT policy contracts",
  "x-domain": "policy",
  "$defs": {
    "PolicyEffect": {
      "title": "PolicyEffect",
      "type": "string",
      "enum": ["allow", "deny", "allow_with_conditions", "escalate"]
    },
    "PolicyDecision": {
      "title": "PolicyDecision",
      "description": "Binds authority to the exact policy version that produced it (ledger Finding I). A CapabilityGrant without a PolicyDecision reference is invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policyDecisionId", "policyBundleDigest", "effect", "subject", "requestedOperations", "requestedScope", "rationale", "decidedBy", "decidedAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "policyDecisionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "policyBundleDigest": { "$ref": "common.schema.json#/$defs/Digest" },
        "effect": { "$ref": "policy.schema.json#/$defs/PolicyEffect" },
        "subject": { "$ref": "common.schema.json#/$defs/ActorRef" },
        "missionId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "taskId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
        "requestedOperations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.:]{1,63}$" } },
        "requestedScope": { "$ref": "capability.schema.json#/$defs/ResourceScope" },
        "conditions": { "type": "array", "maxItems": 32, "items": { "$ref": "capability.schema.json#/$defs/GrantCondition" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "decidedBy": {
          "description": "Only the governance kernel may produce a PolicyDecision (invariant 2). Enforced by the authority conformance test.",
          "$ref": "common.schema.json#/$defs/ActorRef"
        },
        "decidedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    }
  }
}
