{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.capt.dev/driver.schema.json",
  "title": "CAPT driver-run state contracts",
  "x-domain": "driver",
  "x-m0a-note": "M0-A defines the contract and state model ONLY. No driver is integrated, no DriverHost exists, and no transport is implemented (ADR-0111).",
  "$defs": {
    "DriverRunState": {
      "title": "DriverRunState",
      "type": "string",
      "enum": ["created", "submitted", "running", "suspended", "cancelled", "completed", "failed", "lost", "reconciled"]
    },
    "DriverReconciliationStatus": {
      "title": "DriverReconciliationStatus",
      "type": "string",
      "enum": ["not_required", "required", "in_progress", "resolved_effect_occurred", "resolved_effect_absent", "unresolvable"]
    },
    "DriverDescriptor": {
      "title": "DriverDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "driverId", "driverVersion", "supportedOperations", "writeCapable"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "driverId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "driverVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "supportedOperations": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "enum": ["describe", "submit", "inspect", "cancel", "resume", "reconcile"] } },
        "writeCapable": { "type": "boolean" }
      }
    },
    "DriverRun": {
      "title": "DriverRun",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "driverRunId", "driverId", "missionId", "taskId", "workOrderVersion", "state", "reconciliationStatus", "createdAt"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "driverRunId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "driverId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "missionId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "taskId": { "$ref": "common.schema.json#/$defs/Identifier" },
        "workOrderVersion": { "type": "integer", "minimum": 1 },
        "externalRunId": { "type": ["string", "null"], "maxLength": 512 },
        "state": { "$ref": "driver.schema.json#/$defs/DriverRunState" },
        "reconciliationStatus": { "$ref": "driver.schema.json#/$defs/DriverReconciliationStatus" },
        "createdAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    }
  }
}
